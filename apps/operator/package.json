{
  "name": "@repo/operator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests",
    "set-webhook": "tsx scripts/set-webhook.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply switch-operator-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply switch-operator-db --remote",
    "clean": "rm -rf .turbo node_modules .cache .wrangler"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@repo/http-client": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/telegram": "workspace:*",
    "@repo/url-validator": "workspace:*",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.9",
    "node-html-markdown": "2.0.0",
    "openai": "7.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@repo/prettier": "workspace:*",
    "@repo/typescript": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "prettier": "@repo/prettier"
}
