{
  "name": "@repo/operator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "set-webhook": "tsx scripts/set-webhook.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply switch-operator-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply switch-operator-db --remote",
    "clean": "rm -rf .turbo node_modules .cache .wrangler"
  },
  "dependencies": {
    "@hono/zod-validator": "catalog:",
    "@repo/http-client": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/telegram": "workspace:*",
    "@repo/url-validator": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "node-html-markdown": "catalog:",
    "openai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@repo/typescript": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
